{
  "name": "simple-personal-inventory",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "start": "node server/src/index.js --production",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/run.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "vite": "^7.1.5"
  }
}
