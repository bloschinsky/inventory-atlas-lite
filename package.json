{
  "name": "simple-personal-inventory",
  "version": "0.73.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-background-model.mjs",
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "start": "node server/src/index.js --production",
    "auth": "node server/src/cli/auth.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/run.js",
    "landing:dev": "vite --config landing/vite.config.js",
    "landing:build": "vite build --config landing/vite.config.js",
    "landing:preview": "vite preview --config landing/vite.config.js",
    "demo:dev": "vite --mode demo",
    "demo:build": "vite build --mode demo",
    "landing:screenshots": "vite build --mode demo && node landing/scripts/capture-screenshots.mjs",
    "landing:social": "node landing/scripts/render-social-images.mjs",
    "mcp:install": "npm ci --prefix mcp --no-audit --no-fund",
    "mcp:start": "npm --prefix mcp start",
    "mcp:test": "npm --prefix mcp test"
  },
  "dependencies": {
    "@tabler/core": "1.5.1",
    "@tabler/icons-vue": "3.46.0",
    "@vue-flow/core": "1.48.2",
    "argon2": "^0.45.2",
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "jsqr": "^1.4.0",
    "multer": "^2.0.2",
    "onnxruntime-node": "^1.30.0",
    "qrcode-generator": "^1.5.0",
    "sharp": "^0.35.4",
    "vue": "^3.5.21",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "markdown-it": "^14.3.2",
    "sql.js": "^1.14.2",
    "vite": "^7.1.5"
  }
}
