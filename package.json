{
  "name": "simple-personal-inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/src/index.js --production",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "vite": "^7.1.5"
  }
}
