# Copy to mcp/deploy/.env (ignored by Git) and fill in. Examples only: use your own names.

# The public host name of the MCP endpoint; DNS must point at this machine, ports 80 and 443 open.
MCP_DOMAIN=mcp.example.com

# Your existing Atlas, as the adapter reaches it. Prefer https when Atlas is on another machine.
ATLAS_BASE_URL=https://atlas.home.example
